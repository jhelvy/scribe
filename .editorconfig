root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.{js,mjs,css,html,json,yml,yaml}]
indent_size = 2

[*.md]
# Markdown uses trailing double-space for hard breaks
trim_trailing_whitespace = false

[viewer/marked.min.js]
# Vendored, MIT. Do not reformat.
insert_final_newline = false
trim_trailing_whitespace = false
