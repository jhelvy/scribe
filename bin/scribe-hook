#!/usr/bin/env python3
"""Hook entry point. Runs on every registered Claude Code event.

Imports are kept to the standard library minimum that :mod:`scribe.hookclient`
needs, because this process starts and dies on every tool call.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from scribe.hookclient import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
